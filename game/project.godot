; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but can be edited easily using the text editor.

config_version=5

[application]

config/name="Athanor Ascension"
config/description="Open-world alchemy and laboratory simulation. Real chemistry, real physics, offline."
run/main_scene="res://scenes/loading/loading_screen.tscn"
config/features=PackedStringArray("4.3", "Compatibility")

[autoload]

SimulationBridge="*res://scripts/chemistry/simulation_bridge.gd"
InputManager="*res://scripts/input/input_manager.gd"
QuestManager="*res://scripts/quests/quest_manager.gd"
SaveManager="*res://scripts/save/save_manager.gd"
SkillManager="*res://scripts/progression/skill_manager.gd"
PlayerVitals="*res://scripts/core/player_vitals.gd"
InventoryManager="*res://scripts/core/inventory_manager.gd"
CompanionManager="*res://scripts/companions/companion_manager.gd"
FactionSystem="*res://scripts/factions/faction_system.gd"
CharacterCreator="*res://scripts/character/character_creator.gd"
CinematicGrade="*res://ui/cinematic_grade.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_debanding=true
environment/defaults/default_environment="res://default_env.tres"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

