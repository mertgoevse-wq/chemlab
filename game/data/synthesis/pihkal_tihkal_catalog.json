  "swiss_target_prediction": {
    "description": "Receptor binding prediction via SwissTargetPrediction API (build-time only, cached in game)",
    "endpoint": "http://www.swisstargetprediction.ch/api/",
    "input_format": "SMILES or InChI",
    "output_format": {
      "targets": [
        {
          "target_name": "5-HT2A receptor",
          "uniprot_id": "P28222",
          "probability": 0.85,
          "known_actives": 1247,
          "ligand_efficiency": 0.42
        },
        {
          "target_name": "5-HT2B receptor",
          "uniprot_id": "P41595",
          "probability": 0.72,
          "known_actives": 892,
          "ligand_efficiency": 0.38
        },
        {
          "target_name": "5-HT2C receptor",
          "uniprot_id": "P28335",
          "probability": 0.68,
          "known_actives": 756,
          "ligand_efficiency": 0.35
        }
      ],
      "pharmacophore_features": ["aromatic", "cationic", "hbd", "hba"],
      "similarity_to_known": 0.89
    },
    "cache_strategy": "Build-time pre-computation for all 360+ compounds. Results stored in game/data/pharmacology/receptor_bindings.json",
    "runtime_usage": "Player designs custom molecule → SMILES generated → cached prediction shown instantly → labeled as 'Simulated receptor affinity prediction'"
  },
