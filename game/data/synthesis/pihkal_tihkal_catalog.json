  "custom_molecule_designer": {
    "description": "Player designs custom molecules in Simulator Mode",
    "workflow": [
      "1. Draw structure (SMILES editor with RDKit validation)",
      "2. Auto-calculate: MW, LogP, TPSA, Lipinski, synthetic accessibility",
      "3. SwissTargetPrediction: receptor binding profile (cached)",
      "4. Docking simulation: AutoDock Vina (simplified, build-time cached)",
      "5. ADMET prediction: pkCSM/ADMETlab (cached)",
      "6. Legal check: Schedule prediction, structural alerts",
      "7. Synthesis planner: Retrosynthesis (ASKCOS/IBM RXN) - suggested routes",
      "8. Save to personal library → test in virtual assay"
    ],
    "virtual_assay": {
      "description": "Test custom molecule in simulated receptor binding assay",
      "assays": [
        "5-HT2A binding (Ki prediction)",
        "5-HT2B binding (cardiotoxicity flag)",
        "5-HT2C binding",
        "hERG inhibition (cardiotoxicity)",
        "DAT/SERT/NET uptake",
        "CYP450 inhibition panel",
        "Ames mutagenicity (Ames test simulation)"
      ],
      "output": "Simulated dose-response curves, IC50/Ki predictions, safety flags"
    }
