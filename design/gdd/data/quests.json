    {
      "quest_id": "q_foren_tox_spe",
      "act": 2,
      "title": "Forensic Toxicology: Solid-Phase Extraction (SPE) Assay",
      "narrative_briefing": {
        "instructor": "Chief Toxicologist Renard",
