# ChemLab Git Ignore Configuration
# Strict Credential & Secret Protection
.env
.env.*
*.secret
*.pem
*.key
credentials.json
token.json
client_secrets.json

# Python Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.pytest_tmp/
.ruff_cache/
*.egg-info/
dist/
build/

# Dependencies
node_modules/
.venv/
env/
venv/

# Blender & Asset Artifacts
*.blend1
*.blend2
*.blend@
*.crash.txt
cache/

# Godot 4 Engine Artifacts
.godot/
*.translation

# OS Specific
Thumbs.db
Desktop.ini
.DS_Store

# Local Claude MCP memory and runtime files
/.athanor/mcp/
.superpowers/
Claude-Code-Game-Studios/
HANDOFF.md

# Vendored third-party skill checkout (fetch on demand)
tools/vendor/game-dev/

# Vendored prompt library (nested git checkout, indexed in docs/ai)
tools/vendor/awesome-prompts/

# Local Godot binary (126 MB, exceeds GitHub limit)
tools/godot/*.exe
